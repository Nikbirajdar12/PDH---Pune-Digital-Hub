<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Pune Digital Hub portal for departmental digital applications and BI reports."
    >

    <title>Pune Digital Hub - PDH</title>

    <style>
        :root {
            --primary-color: #152ea9;
            --primary-dark: #0d2180;
            --secondary-color: #0078d4;
            --secondary-dark: #005ea6;
            --background-color: #f4f6f8;
            --card-background: #ffffff;
            --text-color: #333333;
            --muted-text: #667085;
            --border-color: #dfe3e8;
            --success-color: #107c10;
            --warning-color: #d83b01;
            --shadow:
                0 4px 14px rgba(15, 23, 42, 0.08);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding: 0;
            font-family:
                "Segoe UI",
                Arial,
                sans-serif;
            color: var(--text-color);
            background-color: var(--background-color);
        }

        button,
        input,
        a {
            font: inherit;
        }

        /* Header */

        .site-header {
            position: relative;
            padding: 34px 20px;
            color: #ffffff;
            text-align: center;
            background:
                linear-gradient(
                    135deg,
                    var(--primary-color),
                    #0878ce
                );
            overflow: hidden;
        }

        .site-header::before {
            content: "";
            position: absolute;
            top: -90px;
            right: -90px;
            width: 230px;
            height: 230px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 50%;
        }

        .site-header::after {
            content: "";
            position: absolute;
            bottom: -120px;
            left: -90px;
            width: 260px;
            height: 260px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 50%;
        }

        .header-content {
            position: relative;
            z-index: 1;
            max-width: 1100px;
            margin: 0 auto;
        }

        .site-header h1 {
            margin: 0;
            font-size: clamp(1.8rem, 5vw, 2.7rem);
            line-height: 1.2;
        }

        .site-header p {
            margin: 10px 0 0;
            font-size: clamp(0.95rem, 2.5vw, 1.15rem);
            opacity: 0.95;
        }

        /* Main container */

        .main-container {
            width: min(1200px, calc(100% - 32px));
            margin: 0 auto;
            padding: 28px 0 40px;
        }

        /* Search */

        .search-panel {
            padding: 20px;
            margin-bottom: 20px;
            background-color: var(--card-background);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: var(--shadow);
        }

        .search-title {
            margin: 0 0 12px;
            color: var(--primary-color);
            font-size: 1.05rem;
        }

        .search-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-box {
            position: relative;
            flex: 1;
        }

        .search-icon {
            position: absolute;
            top: 50%;
            left: 16px;
            transform: translateY(-50%);
            pointer-events: none;
        }

        #appSearch {
            width: 100%;
            min-height: 48px;
            padding: 12px 45px;
            color: var(--text-color);
            background: #ffffff;
            border: 1px solid #b8c1cc;
            border-radius: 10px;
            outline: none;
            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        #appSearch:focus {
            border-color: var(--secondary-color);
            box-shadow:
                0 0 0 3px rgba(0, 120, 212, 0.16);
        }

        .clear-button {
            min-height: 48px;
            padding: 10px 18px;
            color: #ffffff;
            background-color: var(--primary-color);
            border: 0;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.2s ease;
        }

        .clear-button:hover {
            background-color: var(--primary-dark);
        }

        .search-status {
            margin: 12px 0 0;
            color: var(--muted-text);
            font-size: 0.9rem;
        }

        /* Department navigation */

        .department-navigation {
            display: flex;
            gap: 10px;
            padding: 4px 0 18px;
            margin-bottom: 4px;
            overflow-x: auto;
            scrollbar-width: thin;
        }

        .department-navigation button {
            flex: 0 0 auto;
            padding: 10px 16px;
            color: var(--primary-color);
            background: #ffffff;
            border: 1px solid var(--primary-color);
            border-radius: 999px;
            cursor: pointer;
            font-weight: 600;
            white-space: nowrap;
            transition:
                color 0.2s ease,
                background-color 0.2s ease,
                transform 0.2s ease;
        }

        .department-navigation button:hover {
            color: #ffffff;
            background-color: var(--primary-color);
            transform: translateY(-1px);
        }

        /* Department sections */

        .department-section {
            margin: 0 0 20px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .department-header {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 18px 22px;
            color: #ffffff;
            background-color: var(--primary-color);
            border: 0;
            cursor: pointer;
            text-align: left;
            font-size: 1.15rem;
            font-weight: 700;
            transition: background-color 0.2s ease;
        }

        .department-header:hover {
            background-color: var(--primary-dark);
        }

        .department-header:focus-visible {
            outline: 3px solid #ffbf47;
            outline-offset: -4px;
        }

        .department-header.production-header {
            background-color: #c35a00;
        }

        .department-header.production-header:hover {
            background-color: #9e4900;
        }

        .department-header.quality-header {
            background-color: #107c10;
        }

        .department-header.quality-header:hover {
            background-color: #0b5f0b;
        }

        .department-header.lnd-header {
            background-color: #5c2d91;
        }

        .department-header.lnd-header:hover {
            background-color: #44206d;
        }

        .department-header.ehs-header {
            background-color: #b14600;
        }

        .department-header.ehs-header:hover {
            background-color: #853500;
        }

        .department-header.csd-header {
            background-color: #006b6b;
        }

        .department-header.csd-header:hover {
            background-color: #005151;
        }

        .department-header.bi-header {
            background-color: #6b3475;
        }

        .department-header.bi-header:hover {
            background-color: #502758;
        }

        .department-arrow {
            flex: 0 0 auto;
            font-size: 1rem;
            transition: transform 0.25s ease;
        }

        .department-header[aria-expanded="true"]
        .department-arrow {
            transform: rotate(180deg);
        }

        .department-content {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(260px, 1fr));
            gap: 18px;
            padding: 20px;
        }

        .department-content.collapsed {
            display: none;
        }

        /* Application cards */

        .app-card {
            display: flex;
            flex-direction: column;
            min-width: 0;
            padding: 20px;
            background: var(--card-background);
            border: 1px solid var(--border-color);
            border-top: 4px solid var(--secondary-color);
            border-radius: 12px;
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                border-color 0.2s ease;
        }

        .app-card:hover {
            transform: translateY(-4px);
            border-color: #a7c7e7;
            box-shadow:
                0 8px 24px rgba(15, 23, 42, 0.12);
        }

        .app-title {
            margin: 0 0 10px;
            color: var(--primary-color);
            font-size: 1.1rem;
            line-height: 1.4;
        }

        .app-description {
            flex: 1;
            margin: 0 0 18px;
            color: var(--muted-text);
            font-size: 0.95rem;
            line-height: 1.55;
        }

        .app-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            align-self: flex-start;
            min-height: 42px;
            padding: 10px 16px;
            color: #ffffff;
            background-color: var(--secondary-color);
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            transition:
                background-color 0.2s ease,
                transform 0.2s ease;
        }

        .app-link:hover {
            background-color: var(--secondary-dark);
            transform: translateY(-1px);
        }

        .app-link:focus-visible {
            outline: 3px solid #ffbf47;
            outline-offset: 3px;
        }

        .placeholder-card {
            border-top-color: #98a2b3;
        }

        .placeholder-label {
            display: inline-block;
            align-self: flex-start;
            padding: 7px 12px;
            color: #475467;
            background: #f2f4f7;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .report-link-placeholder {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            align-self: flex-start;
            min-height: 42px;
            padding: 10px 16px;
            color: #667085;
            background-color: #eaecf0;
            border-radius: 8px;
            cursor: not-allowed;
            font-weight: 700;
        }

        .hidden {
            display: none !important;
        }

        /* No-results message */

        .no-results {
            display: none;
            padding: 30px 20px;
            margin-top: 10px;
            color: var(--muted-text);
            background: #ffffff;
            border: 1px dashed #98a2b3;
            border-radius: 14px;
            text-align: center;
        }

        .no-results.visible {
            display: block;
        }

        .no-results h2 {
            margin: 0 0 8px;
            color: var(--primary-color);
            font-size: 1.25rem;
        }

        .no-results p {
            margin: 0;
        }

        /* Footer */

        .site-footer {
            padding: 20px;
            color: #ffffff;
            background-color: var(--primary-color);
            text-align: center;
        }

        .site-footer p {
            margin: 0;
        }

        /* Tablet */

        @media (max-width: 768px) {
            .site-header {
                padding: 28px 16px;
            }

            .main-container {
                width: min(100% - 24px, 1200px);
                padding-top: 20px;
            }

            .search-panel {
                padding: 16px;
            }

            .search-row {
                align-items: stretch;
                flex-direction: column;
            }

            .clear-button {
                width: 100%;
            }

            .department-header {
                padding: 16px;
                font-size: 1.05rem;
            }

            .department-content {
                grid-template-columns: 1fr;
                padding: 14px;
            }

            .app-card {
                padding: 18px;
            }
        }

        /* Small mobile */

        @media (max-width: 420px) {
            .site-header h1 {
                font-size: 1.65rem;
            }

            .site-header p {
                font-size: 0.9rem;
            }

            .main-container {
                width: min(100% - 16px, 1200px);
            }

            .department-header {
                padding: 14px;
            }

            .department-content {
                padding: 10px;
            }

            .app-card {
                padding: 16px;
            }

            .app-link {
                width: 100%;
            }
        }

        /* Reduced motion accessibility */

        @media (prefers-reduced-motion: reduce) {
            * {
                scroll-behavior: auto !important;
                transition: none !important;
            }
        }
    </style>
</head>

