    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput =
                document.getElementById("appSearch");

            const clearButton =
                document.getElementById("clearSearch");

            const searchStatus =
                document.getElementById("searchStatus");

            const noResults =
                document.getElementById("noResults");

            const departmentSections =
                document.querySelectorAll(".department-section");

            const departmentHeaders =
                document.querySelectorAll(".department-header");

            const navigationButtons =
                document.querySelectorAll(
                    "[data-scroll-target]"
                );

            /*
             * Department expand and collapse
             */
            departmentHeaders.forEach(function (header) {
                header.addEventListener("click", function () {
                    const contentId =
                        header.getAttribute("aria-controls");

                    const content =
                        document.getElementById(contentId);

                    const isExpanded =
                        header.getAttribute("aria-expanded") ===
                        "true";

                    header.setAttribute(
                        "aria-expanded",
                        String(!isExpanded)
                    );

                    content.classList.toggle(
                        "collapsed",
                        isExpanded
                    );
                });
            });

            /*
             * Quick department navigation
             */
            navigationButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const targetId =
                        button.getAttribute(
                            "data-scroll-target"
                        );

                    const targetSection =
                        document.getElementById(targetId);

                    const targetHeader =
                        targetSection.querySelector(
                            ".department-header"
                        );

                    const targetContent =
                        targetSection.querySelector(
                            ".department-content"
                        );

                    targetHeader.setAttribute(
                        "aria-expanded",
                        "true"
                    );

                    targetContent.classList.remove("collapsed");

                    targetSection.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                });
            });

            /*
             * Search applications, reports and departments
             */
            function filterSolutions() {
                const query =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                let visibleCardCount = 0;

                departmentSections.forEach(
                    function (section) {
                        const departmentKeywords =
                            (
                                section.dataset.department || ""
                            ).toLowerCase();

                        const sectionHeader =
                            section.querySelector(
                                ".department-header"
                            );

                        const sectionContent =
                            section.querySelector(
                                ".department-content"
                            );

                        const cards =
                            section.querySelectorAll(
                                ".app-card"
                            );

                        let sectionHasMatch = false;

                        const departmentMatches =
                            query !== "" &&
                            departmentKeywords.includes(query);

                        cards.forEach(function (card) {
                            const cardText =
                                card.textContent.toLowerCase();

                            const cardMatches =
                                query === "" ||
                                departmentMatches ||
                                cardText.includes(query);

                            card.classList.toggle(
                                "hidden",
                                !cardMatches
                            );

                            if (cardMatches) {
                                sectionHasMatch = true;
                                visibleCardCount++;
                            }
                        });

                        section.classList.toggle(
                            "hidden",
                            !sectionHasMatch
                        );

                        if (
                            query !== "" &&
                            sectionHasMatch
                        ) {
                            sectionHeader.setAttribute(
                                "aria-expanded",
                                "true"
                            );

                            sectionContent.classList.remove(
                                "collapsed"
                            );
                        }
                    }
                );

                noResults.classList.toggle(
                    "visible",
                    visibleCardCount === 0
                );

                if (query === "") {
                    searchStatus.textContent =
                        "Showing all digital solutions.";
                } else if (visibleCardCount === 0) {
                    searchStatus.textContent =
                        'No results found for "' +
                        searchInput.value.trim() +
                        '".';
                } else {
                    searchStatus.textContent =
                        visibleCardCount +
                        " matching solution" +
                        (visibleCardCount === 1 ? "" : "s") +
                        " found.";
                }
            }

            searchInput.addEventListener(
                "input",
                filterSolutions
            );

            clearButton.addEventListener(
                "click",
                function () {
                    searchInput.value = "";
                    filterSolutions();
                    searchInput.focus();
                }
            );

            /*
             * Allow Escape key to clear search
             */
            searchInput.addEventListener(
                "keydown",
                function (event) {
                    if (
                        event.key === "Escape" &&
                        searchInput.value !== ""
                    ) {
                        searchInput.value = "";
                        filterSolutions();
                    }
                }
            );

            /*
             * Set footer year automatically
             */
            document.getElementById(
                "currentYear"
            ).textContent = new Date().getFullYear();

            filterSolutions();
        });
    </script>

</body>
</html>
